#!/usr/bin/env bash
set -euo pipefail

# Generated for setup={{ setup }} profile={{ profile }} access={{ access }}
# Preflight validation for the generated workspace (no Docker daemon required).

fail=0

for f in docker-compose.yml .env manifest.json; do
  if [ ! -f "$f" ]; then
    printf "Missing required file: %s\n" "$f" >&2
    fail=1
  fi
done

{% if access == "lan" %}
if ! grep -q '^API_BEARER_TOKEN=' .env; then
  printf "LAN workspace missing API_BEARER_TOKEN in .env.\n" >&2
  fail=1
fi
if ! grep -q '^LAN_ALLOWLIST=' .env; then
  printf "LAN workspace missing LAN_ALLOWLIST in .env.\n" >&2
  fail=1
fi
{% else %}
if grep -q '0.0.0.0:{{ host_port }}:8000' docker-compose.yml; then
  printf "localhost workspace unexpectedly binds to 0.0.0.0.\n" >&2
  fail=1
fi
{% endif %}

if [ "$fail" -ne 0 ]; then
  printf "Host validation failed.\n" >&2
  exit 1
fi

printf "Host validation passed.\n"

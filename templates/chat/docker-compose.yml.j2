services:
  llama-server:
    image: ghcr.io/ggerganov/llama.cpp:server
    container_name: ai-lab-llama-server-{{ setup }}
    restart: unless-stopped
    ports:
{% if access == "lan" %}
      - "0.0.0.0:{{ host_port }}:8000"
{% else %}
      - "127.0.0.1:{{ host_port }}:8000"
{% endif %}
    env_file:
      - path: .env
        required: false
    command:
      - --model
      - {{ container_model_path }}
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --ctx-size
      - "{{ ctx_size }}"
      - --threads
      - "{{ threads }}"
      - --batch-size
      - "{{ batch_size }}"
      - --n-predict
      - "{{ n_predict }}"
      - --metrics
      - --cont-batching
{% if access == "lan" %}
      - --api-key
      - ${API_BEARER_TOKEN:?bearer token required for LAN access}
{% endif %}
    volumes:
      - ./models:/models:ro
      - ./logs:/logs
    mem_limit: {{ mem_limit }}
    cpus: {{ cpu_limit }}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:size=256m

services:
  llama-server:
    image: {{ serving_image }}
    container_name: ai-lab-llama-server-{{ setup }}
    restart: "no"
    ports:
      - "127.0.0.1:{{ host_port }}:8000"
    env_file:
      - path: .env
        required: false
    command:
      - --model
      - {{ container_model_path_yaml }}
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --ctx-size
      - "{{ ctx_size }}"
      - --threads
      - "{{ threads }}"
      - --batch-size
      - "{{ batch_size }}"
      - --n-predict
      - "{{ n_predict }}"
      - --metrics
      - --cont-batching
    volumes:
      - type: bind
        source: {{ host_model_path_yaml }}
        target: /models/model.gguf
        read_only: true
    mem_limit: {{ mem_limit }}
    cpus: {{ cpu_limit }}
    pids_limit: 256
    user: "65532:65532"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:size=256m

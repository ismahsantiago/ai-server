{
  "schema": "ai-server-generated-v1",
  "setup": "{{ setup }}",
  "profile": "{{ profile }}",
  "access": "{{ access }}",
  "generated_at": "{{ generated_at }}",
  "model_path": "{{ model_path }}",
  "container_model_path": "{{ container_model_path }}",
  "preset_alias": "{{ preset_alias }}",
  "preset_name": "{{ preset_name }}",
  "preset_summary": "{{ preset_summary }}",
  "capability_tags": "{{ capability_tags }}",
  "memory_guidance": "{{ memory_guidance }}",
  "shorthand_mode": {{ "true" if shorthand_mode else "false" }},
  "resolved_setup": "{{ resolved_setup }}",
  "resolved_profile": "{{ resolved_profile }}",
  "resolved_access": "{{ resolved_access }}",
  "host_port": "{{ host_port }}",
  "auth": "{{ auth }}",
  "lan_allowlist": "{{ lan_allowlist }}",
  "quick_commands": {
    "validate": "{{ quick_validate_command }}",
    "start": "{{ quick_start_command }}",
    "smoke": "{{ quick_smoke_command }}"
  },
  "required_files": [
{% for f in required_files %}    "{{ f }}"{% if not loop.last %},{% endif %}
{% endfor %}  ]
}

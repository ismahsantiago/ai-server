{
  "name": "chat",
  "description": "OpenAI-compatible local chat endpoint using llama.cpp server.",
  "default_profile": "medium",
  "supported_profiles": ["medium-fast", "medium", "good"],
  "supported_access": ["localhost", "lan"],
  "required_files": [
    "docker-compose.yml",
    ".env",
    "manifest.json",
    "README.md",
